<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>diskercise</id>
    <version>1.0.0.1</version>
    <title>Diskercise (1.0.0.1)</title>
    <authors>SSD TestKit</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      Offline portable installation of Diskercise 1.0.0.1.
      Copies Diskercise.exe, PCIE_Diskercise_CLI.exe and Autoit_Setup.ini
      to C:\tools\Diskercise and sets the DISKERCISE_PATH environment variable.
      Requires SSD_TESTKIT_ROOT environment variable to locate the source files.
    </description>
    <tags>diskercise disk exercise pcie portable offline</tags>
  </metadata>
</package>
